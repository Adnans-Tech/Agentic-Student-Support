# ============================================================
# ACE ASSIST — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# ============================================================


# ─── LLM ────────────────────────────────────────────────────
# Groq API Key (REQUIRED) — powers all AI agents
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here


# ─── EMAIL ──────────────────────────────────────────────────
# SendGrid API Key (REQUIRED) — for ticket & faculty emails
# Get yours at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Verified sender email address (must match your SendGrid account)
NOTIFICATION_EMAIL_FROM=your_verified_email@example.com


# ─── AUTHENTICATION ─────────────────────────────────────────
# JWT Secret Key — use a long random string in production!
JWT_SECRET_KEY=change-this-to-a-secure-random-secret

# OTP email verification toggle (true = enabled, false = disabled)
ENABLE_OTP=false


# ─── DATABASE ───────────────────────────────────────────────
# Set to true to use Supabase PostgreSQL (required for Vercel)
# Set to false to use local SQLite (development only)
USE_POSTGRES=false

# Supabase PostgreSQL connection string (required if USE_POSTGRES=true)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=your_supabase_database_url_here

# Optional: Supabase connection pooler URL (recommended for Vercel deployments)
# Use the "Transaction" pooler from your Supabase project settings
SUPABASE_DB_URL_POOLER=your_supabase_pooler_url_here


# ─── FRONTEND ───────────────────────────────────────────────
# Frontend URL for CORS — change to your Vercel domain in production
FRONTEND_URL=http://localhost:5173


# ─── CHAT MEMORY ────────────────────────────────────────────
# Backend for chat memory storage
# Options: "sqlite" (local dev) | "redis" (production via Upstash)
CHAT_MEMORY_BACKEND=sqlite
